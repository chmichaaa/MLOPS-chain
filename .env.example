# Copy to .env and fill in real values before `docker compose up`. Never commit .env.

POSTGRES_USER=mlops
POSTGRES_PASSWORD=change-me

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too

# Bucket used for both MLflow artifacts and batch-prediction/drift-monitoring uploads.
S3_BUCKET=infra-monitoring

AIRFLOW_UID=50000

# dataset-uploader (the MLOps console, port 8090): a GitHub fine-grained PAT
# scoped to this one repo with "Contents: Read and write" -- create one at
# github.com/settings/tokens?type=beta. Lets the console push dataset updates
# on your behalf. Never commit this.
GIT_TOKEN=

# dataset-uploader: required to create the FIRST account on /signup, which
# becomes the console administrator. Once that account exists, self-service
# signup closes permanently and further accounts are created by an
# administrator at /admin/users -- so this code only matters during initial
# setup. Pick a real random string, not this placeholder.
SIGNUP_CODE=change-me-too

# dataset-uploader: signs session cookies. Pick a real random string.
SESSION_SECRET_KEY=change-me-again

# Grafana (port 3000) login. Pick a real password, not this placeholder.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-too

# The box's public IP (or domain, if you get one). Two uses:
# - dataset-uploader: builds browser-facing links/iframes (the "Open MLflow"
#   link, the embedded Grafana dashboard on /monitoring) -- these can't use
#   internal docker hostnames like mlflow-server or grafana, since the
#   user's own browser can't resolve those.
# - grafana: sets GF_SERVER_ROOT_URL so Grafana knows its own real external
#   address -- without this it defaults to assuming localhost:3000, and
#   fails to load its JS bundle (shows Grafana's own "failed to load its
#   application files" screen) when actually accessed via a public IP.
# Set this once to your Elastic IP and it never needs updating again, even
# if you re-associate the instance.
PUBLIC_HOST=localhost

# dag_backup.py (airflow/dags/dag_backup.py): a SEPARATE, least-privilege real
# AWS IAM user -- write access to just this one bucket (s3:PutObject on
# arn:aws:s3:::<bucket>/*), nothing else. Deliberately not the same
# credentials used for ECR, and not the MinIO-flavored AWS_ACCESS_KEY_ID/
# SECRET used everywhere else in this file -- this one talks to real AWS S3,
# genuinely off-box, so losing the EC2 instance itself doesn't lose backups
# with it. Leave blank to leave backups disabled.
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=

# live-feed (live_feed/generator.py): the simulated telemetry behind the
# console's /live page. All optional -- the defaults below are what the
# service uses if unset. Tick interval is how often a reading is generated
# and scored; an incident is injected for LENGTH ticks out of every EVERY
# ticks (so at the defaults: a 42-second incident every 2 minutes).
# LIVE_FEED_TICK_SECONDS=3
# LIVE_FEED_INCIDENT_EVERY_TICKS=40
# LIVE_FEED_INCIDENT_LENGTH_TICKS=14
# LIVE_FEED_RETENTION_HOURS=24

# Only needed on the production EC2 host, not for local dev. Set after the
# first successful CI build to the exact image the `build` job pushes, so
# `docker compose pull app` (run by the CI `deploy` job over SSH) fetches the
# gate-approved image instead of building one locally.
# ECR_IMAGE=<account>.dkr.ecr.eu-north-1.amazonaws.com/<repo>:latest
