# Copy to .env and fill in real values before `docker compose up`. Never commit .env.

POSTGRES_USER=mlops
POSTGRES_PASSWORD=change-me

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too

# Bucket used for both MLflow artifacts and batch-prediction/drift-monitoring uploads.
S3_BUCKET=infra-monitoring

AIRFLOW_UID=50000

# Only needed on the production EC2 host, not for local dev. Set after the
# first successful CI build to the exact image the `build` job pushes, so
# `docker compose pull app` (run by the CI `deploy` job over SSH) fetches the
# gate-approved image instead of building one locally.
# ECR_IMAGE=<account>.dkr.ecr.us-east-2.amazonaws.com/<repo>:latest
