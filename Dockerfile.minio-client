# Extracts mc from cgr.dev/chainguard/minio:latest (confirmed present at
# /usr/bin/mc via `docker cp`) onto a base that actually has a shell --
# cgr.dev/chainguard/minio-client:latest has none at all (confirmed:
# "exec: /bin/sh: stat /bin/sh: no such file or directory", needed for the
# `&&`-chained, variable-substituting entrypoint below). dl.min.io's direct
# binary downloads are also retired (410 Gone as of 2026-10), so this reuses
# the one MinIO source actually confirmed to pull and run correctly, instead
# of depending on a third one.
FROM cgr.dev/chainguard/minio:latest AS minio-src

FROM debian:bookworm-slim
COPY --from=minio-src /usr/bin/mc /usr/local/bin/mc
ENTRYPOINT ["mc"]
